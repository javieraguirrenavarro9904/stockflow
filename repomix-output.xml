<file path="apps/web/src/styles.css">
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
  font-family: 'DM Sans', sans-serif;
  color: #17231f;
  background: #f5f7f6;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  --green: #17865d;
  --green-dark: #116d4b;
  --green-light: #e8f5ee;
  --text: #17231f;
  --muted: #84908b;
  --line: #e9eeeb;
  --panel: #fff;
}

* { box-sizing: border-box; }
body { margin: 0; min-width: 360px; min-height: 100vh; }
button, input, select { font: inherit; }
button { cursor: pointer; }
.app-shell { display: flex; min-height: 100vh; }

.sidebar { width: 246px; min-width: 0; flex: 0 0 246px; overflow: hidden; background: #fff; border-right: 1px solid #e8edeb; padding: 25px 14px 14px; display: flex; flex-direction: column; transition: width .2s ease, flex-basis .2s ease, padding .2s ease; }
.app-shell.sidebar-collapsed .sidebar { width: 0; flex-basis: 0; padding-right: 0; padding-left: 0; border-right: 0; visibility: hidden; pointer-events: none; }
.brand { height: 34px; display: flex; align-items: center; gap: 10px; padding: 0 10px; color: #16362a; font: 800 21px 'Manrope', sans-serif; letter-spacing: -1px; }
.brand-mark { width: 30px; height: 30px; display: grid; place-items: center; color: #fff; background: #18885e; border-radius: 9px; }
.brand-dot { color: #1c9a68; }
.warehouse-switch { position: relative; width: 100%; margin: 32px 2px 29px; padding: 11px 9px; display: flex; align-items: center; gap: 10px; border: 1px solid #edf0ee; border-radius: 9px; color: inherit; background: #fff; text-align: left; }
.warehouse-switch:hover, .warehouse-switch.open { border-color: #cfe2d6; background: #fbfdfb; }
.warehouse-icon { width: 31px; height: 31px; display: grid; place-items: center; border-radius: 7px; color: #25885f; background: #ebf6ef; }
.warehouse-copy { flex: 1; min-width: 0; }
.warehouse-switch strong { display: block; font-size: 11.5px; margin-top: 4px; white-space: nowrap; }
.overline, .nav-heading, .eyebrow { color: #9aa49f; font-size: 9px; letter-spacing: 1.15px; font-weight: 700; }
.muted-icon { color: #9ba6a1; }
.nav-heading { padding: 0 11px; margin-bottom: 10px; }
.nav-list { display: grid; gap: 4px; }
.nav-item { border: 0; background: transparent; color: #67736d; width: 100%; padding: 10px 11px; display: flex; align-items: center; gap: 12px; text-align: left; border-radius: 7px; font-size: 12px; transition: background .15s, color .15s; }
.nav-item:hover { background: #f6f8f7; color: #293d34; }
.nav-item.selected { color: #147c54; background: #eaf5ee; font-weight: 700; }
.nav-item span:nth-child(2) { flex: 1; }
.nav-count { border-radius: 10px; padding: 2px 6px; background: #fff0e7; color: #cb6d29; font-size: 10px; font-weight: 700; }
.beta-tag { border-radius: 4px; background: #f1ecff; padding: 3px 5px; color: #815ac2; font-size: 8px; letter-spacing: .5px; font-weight: 700; }
.sidebar-bottom { margin-top: auto; }
.sync-status { margin: 0 4px 17px; padding: 11px 10px; display: flex; align-items: center; gap: 10px; border-radius: 8px; background: #f8faf9; }
.status-pulse { width: 8px; height: 8px; background: #32b77d; border-radius: 50%; box-shadow: 0 0 0 4px #e3f5eb; }
.sync-status strong, .sync-status small, .profile-copy strong, .profile-copy small { display: block; }
.sync-status strong { font-size: 10px; font-weight: 600; }
.sync-status small, .profile-copy small { margin-top: 3px; color: #98a39e; font-size: 9px; }
.profile { margin-top: 12px; padding: 13px 5px 0; border-top: 1px solid #eef1ef; display: flex; align-items: center; gap: 9px; }
.profile { width: 100%; border-right: 0; border-bottom: 0; border-left: 0; background: transparent; text-align: left; }
.profile:hover .profile-copy strong { color: #167c54; }
.avatar, .top-avatar { width: 31px; height: 31px; display: grid; place-items: center; color: #7a573d; background: #f2e7dc; border-radius: 50%; font-size: 10px; font-weight: 700; }
.profile-copy { flex: 1; }
.profile-copy strong { font-size: 10px; }

.main-area { flex: 1; min-width: 0; }
.topbar { height: 67px; padding: 0 37px; display: flex; align-items: center; justify-content: space-between; gap: 16px; background: rgba(255,255,255,.82); border-bottom: 1px solid #e9eeeb; }
.topbar-leading { min-width: 0; display: flex; align-items: center; gap: 12px; }
.sidebar-toggle { width: 34px; height: 34px; flex: 0 0 34px; display: grid; place-items: center; border: 1px solid #e8edeb; border-radius: 6px; color: #64736a; background: #fff; }
.sidebar-toggle:hover { color: #177d55; border-color: #bdd8c9; background: #f7fbf8; }
.breadcrumbs { display: flex; align-items: center; gap: 10px; color: #96a19c; font-size: 11px; }
.breadcrumbs strong { color: #334139; font-weight: 600; }
.top-actions { display: flex; align-items: center; gap: 19px; }
.global-search { height: 34px; width: 245px; padding: 0 9px; display: flex; align-items: center; gap: 8px; border: 1px solid #e8edeb; border-radius: 6px; background: #fff; color: #8d9993; }
.global-search input { flex: 1; min-width: 0; border: 0; outline: 0; color: #34443c; font-size: 10px; background: transparent; }
.global-search input::placeholder { color: #a7b0ac; }
kbd { display: flex; align-items: center; gap: 3px; padding: 3px 5px; color: #97a19c; border: 1px solid #e9edeb; border-radius: 4px; font-size: 9px; }
.icon-button { width: 32px; height: 32px; display: inline-grid; place-items: center; border: 0; border-radius: 6px; color: #7f8a85; background: transparent; }
.icon-button:hover, .row-menu:hover { color: #1a8058; background: #f0f7f3; }
.notification-button { position: relative; }
.notification-button i { position: absolute; top: 6px; right: 6px; width: 6px; height: 6px; border: 1px solid white; border-radius: 50%; background: #ed8c46; }
.top-avatar { width: 29px; height: 29px; }
.top-avatar-button { border: 0; cursor: pointer; }
.top-avatar-button:hover { outline: 2px solid #cfe8d8; }
.notification-wrap { position: relative; }
.notification-popover, .warehouse-popover { position: absolute; z-index: 15; width: 290px; padding: 10px; border: 1px solid #e6ece8; border-radius: 8px; background: #fff; box-shadow: 0 12px 35px #18372816; }
.notification-popover { top: 40px; right: -15px; }
.notification-title { padding: 5px 5px 9px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #edf1ee; color: #37473e; font-size: 10px; }
.notification-title span { min-width: 20px; padding: 3px 5px; border-radius: 10px; color: #b86f38; background: #fff3e7; text-align: center; font-size: 8px; }
.notification-item { width: 100%; padding: 9px 5px; display: flex; align-items: center; gap: 8px; border: 0; border-bottom: 1px solid #f1f3f2; color: #6e7c74; background: #fff; text-align: left; }
.notification-item:hover { background: #f8faf8; }
.notification-item > span:nth-child(2) { min-width: 0; flex: 1; }
.notification-item strong, .notification-item small { display: block; }
.notification-item strong { color: #526158; font-size: 9px; }
.notification-item small { overflow: hidden; margin-top: 4px; color: #929e97; font-size: 8px; text-overflow: ellipsis; white-space: nowrap; }
.notification-alert { width: 8px; height: 8px; flex: 0 0 8px; border-radius: 50%; background: #e6a05e; }
.notification-alert.expiry { background: #d3b44c; }
.notification-empty { padding: 20px 8px; display: flex; align-items: center; justify-content: center; gap: 7px; color: #63866f; font-size: 9px; }
.warehouse-popover { top: 104px; left: 18px; }
.warehouse-popover > strong { display: block; color: #405047; font-size: 10px; }
.warehouse-popover > button { width: 100%; margin-top: 10px; padding: 8px 0 0; display: flex; align-items: center; justify-content: space-between; border: 0; border-top: 1px solid #edf1ee; color: #187c55; background: transparent; font-size: 9px; }
.warehouse-popover .warehouse-option { margin-top: 3px; display: flex; align-items: center; gap: 4px; }
.warehouse-option-select { min-width: 0; flex: 1; margin: 0; padding: 8px 5px; display: flex; align-items: center; gap: 8px; border: 0; border-radius: 5px; color: #53645a; background: transparent; font-size: 10px; text-align: left; }
.warehouse-option-select:hover, .warehouse-option-select.active { color: #177d55; background: #edf7f0; }
.warehouse-option-name { min-width: 0; overflow: hidden; flex: 1; text-overflow: ellipsis; white-space: nowrap; }
.warehouse-option-select small { margin-left: auto; color: #87958d; font-size: 8px; }
.warehouse-delete { width: 29px; height: 29px; flex: 0 0 29px; display: grid; place-items: center; border: 0; border-radius: 5px; color: #a56a5b; background: transparent; }
.warehouse-delete:hover { color: #a23d2b; background: #fff0eb; }
.warehouse-popover .warehouse-add { justify-content: flex-start; gap: 7px; color: #187c55; }
.page-content { max-width: 1440px; margin: 0 auto; padding: 31px 37px 54px; }
.page-intro { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 25px; }
.page-intro h1 { margin: 7px 0 5px; color: #1e2b25; font: 700 25px 'Manrope', sans-serif; letter-spacing: -.75px; }
.page-intro p { margin: 0; color: #7c8982; font-size: 11px; }
.intro-actions { display: flex; gap: 8px; flex-shrink: 0; }
.button { height: 35px; padding: 0 12px; display: inline-flex; align-items: center; justify-content: center; gap: 7px; border: 1px solid transparent; border-radius: 6px; font-size: 10px; font-weight: 600; white-space: nowrap; transition: .15s; }
.button-primary { background: #18865d; color: #fff; box-shadow: 0 2px 4px #18865d1c; }
.button-primary:hover { background: #116f4c; }
.button-secondary { border-color: #e5ebe8; background: #fff; color: #536159; }
.button-secondary:hover { border-color: #bdd8c9; color: #177d55; }
.button-danger { border-color: #f0d7d1; color: #a64e37; background: #fff7f4; }
.button-danger:hover { border-color: #dfb4a8; background: #fff0eb; }
.button:disabled, button:disabled { cursor: not-allowed; opacity: .48; }

.stats-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-bottom: 19px; }
.stat-card { min-height: 125px; padding: 15px 16px; position: relative; display: flex; flex-direction: column; align-items: flex-start; background: white; border: 1px solid #e9eeeb; border-radius: 8px; }
.stat-icon { width: 29px; height: 29px; display: grid; place-items: center; border-radius: 7px; margin-bottom: 12px; }
.stat-icon.green, .quick-icon.green { color: #1b885c; background: #eaf6ef; }
.stat-icon.blue, .quick-icon.blue { color: #4586bd; background: #edf5fb; }
.stat-icon.purple, .quick-icon.purple { color: #8360bd; background: #f3effa; }
.stat-icon.orange { color: #d08238; background: #fff3e8; }
.stat-label { position: absolute; top: 22px; left: 54px; color: #737f79; font-size: 10px; }
.stat-value { color: #1d2b24; font: 700 22px 'Manrope', sans-serif; letter-spacing: -.5px; }
.stat-note { margin-top: 3px; color: #98a39e; font-size: 9px; }
.stat-alert { margin-left: 8px; padding: 4px 6px; color: #b97031; background: #fff4e9; border-radius: 4px; vertical-align: middle; font: 600 8px 'DM Sans', sans-serif; letter-spacing: 0; }
.dashboard-grid { display: grid; grid-template-columns: minmax(0, 1.75fr) minmax(275px, .92fr); gap: 15px; }
.panel { background: white; border: 1px solid #e9eeeb; border-radius: 8px; }
.activity-panel, .attention-panel { min-width: 0; overflow: hidden; }
.panel-heading { padding: 17px 17px 12px; display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
.panel-heading h2, .map-panel-heading h2 { margin: 0; color: #26342d; font: 700 12px 'Manrope', sans-serif; }
.panel-heading p, .map-panel-heading p { margin: 4px 0 0; color: #95a09a; font-size: 9px; }
.text-button { padding: 0; display: flex; align-items: center; gap: 2px; border: 0; color: #168158; background: none; font-size: 9px; font-weight: 600; }
.table-wrap { width: 100%; overflow-x: auto; }
table { width: 100%; border-collapse: collapse; text-align: left; white-space: nowrap; }
th { padding: 9px 14px; color: #a0aaa5; background: #fafbfa; border-top: 1px solid #f0f3f1; border-bottom: 1px solid #edf1ee; font-size: 8px; letter-spacing: .65px; font-weight: 700; }
td { padding: 10px 14px; border-bottom: 1px solid #f0f2f1; color: #56635b; font-size: 9px; }
tbody tr:last-child td { border-bottom: 0; }
.movement-type { display: inline-flex; align-items: center; gap: 5px; font-size: 9px; font-weight: 600; }
.movement-type.incoming { color: #21865e; }
.movement-type.outgoing { color: #d17b3d; }
.movement-type.neutral { color: #6d82a2; }
.table-primary, .table-secondary { display: block; }
.table-primary { max-width: 235px; overflow: hidden; color: #415047; font-size: 9px; text-overflow: ellipsis; font-weight: 600; }
.table-secondary { margin-top: 3px; color: #a0aaa4; font-size: 8px; }
.unit-value { color: #34443a; font-weight: 600; }
.date-value { color: #8e9993; }
.table-empty { padding: 28px 15px; color: #939e98; text-align: center; font-size: 10px; }
.attention-count { display: grid; min-width: 21px; height: 21px; place-items: center; border-radius: 50%; color: #c97b3a; background: #fff2e6; font-size: 9px; font-weight: 700; }
.attention-list { min-height: 175px; padding: 0 16px; }
.attention-row { min-height: 52px; display: flex; align-items: center; gap: 9px; border-bottom: 1px solid #f1f3f2; }
.attention-icon { width: 27px; height: 27px; flex: 0 0 27px; display: grid; place-items: center; border-radius: 6px; }
.attention-icon.orange { color: #d08544; background: #fff4e9; }
.attention-icon.yellow { color: #b9933c; background: #fff9e6; }
.attention-copy { min-width: 0; flex: 1; }
.attention-copy strong, .attention-copy span { display: block; }
.attention-copy strong { color: #4c5a51; font-size: 9px; font-weight: 600; }
.attention-copy span { max-width: 175px; overflow: hidden; margin-top: 3px; color: #98a29d; font-size: 8px; text-overflow: ellipsis; }
.attention-value { color: #a67545; font-size: 8px; }
.attention-link { width: calc(100% - 32px); margin: 12px 16px 14px; padding: 0; display: flex; align-items: center; justify-content: space-between; border: 0; color: #18835b; background: transparent; font-size: 9px; font-weight: 600; }
.empty-inline { min-height: 90px; display: flex; align-items: center; justify-content: center; gap: 8px; color: #5b8b70; font-size: 10px; }
.quick-actions { margin-top: 18px; padding: 15px 16px 16px; display: grid; grid-template-columns: 1.1fr repeat(3, 1fr); align-items: center; gap: 12px; background: #fff; border: 1px solid #e9eeeb; border-radius: 8px; }
.quick-actions h2 { margin: 6px 0 0; color: #29372f; font: 700 12px 'Manrope', sans-serif; }
.quick-card { min-height: 55px; padding: 8px; display: flex; align-items: center; gap: 9px; border: 1px solid #eff2f0; border-radius: 7px; background: white; text-align: left; }
.quick-card:hover { border-color: #c8e0d1; background: #fbfdfb; }
.quick-icon { width: 30px; height: 30px; display: grid; flex: 0 0 30px; place-items: center; border-radius: 7px; }
.quick-card span { min-width: 0; flex: 1; }
.quick-card strong, .quick-card small { display: block; white-space: nowrap; }
.quick-card strong { color: #3a4940; font-size: 9px; }
.quick-card small { margin-top: 4px; color: #9aa49f; font-size: 8px; }
.quick-card > svg { color: #a0aaa5; }

.inventory-panel, .movement-history { overflow: hidden; }
.inventory-toolbar { min-height: 53px; padding: 0 16px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.filter-tabs { display: flex; align-items: center; align-self: stretch; gap: 19px; }
.filter-tabs button { position: relative; padding: 0; display: flex; align-items: center; gap: 6px; border: 0; background: none; color: #84908a; font-size: 10px; }
.filter-tabs button.active { color: #197e56; font-weight: 700; }
.filter-tabs button.active::after { position: absolute; right: 0; bottom: 0; left: 0; height: 2px; content: ''; background: #1b895e; }
.filter-count { padding: 2px 5px; border-radius: 9px; background: #fff1e6; color: #cb7c3d; font-size: 8px; }
.inventory-tools { display: flex; align-items: center; gap: 11px; color: #99a29e; font-size: 9px; }
.inventory-table th, .inventory-table td { padding-left: 13px; padding-right: 13px; }
.product-cell { display: flex; align-items: center; gap: 9px; }
.product-thumb { width: 32px; height: 32px; display: grid; flex: 0 0 32px; place-items: center; color: #4b8970; background: #edf5f0; border-radius: 7px; }
.thumb-1 { color: #617da3; background: #edf2f8; }
.thumb-2 { color: #aa7f4e; background: #f8f1e8; }
.thumb-3 { color: #8b6aa5; background: #f4eff8; }
.thumb-4 { color: #498b96; background: #eaf4f5; }
.product-cell strong, .product-cell small { display: block; }
.product-cell strong { color: #34443b; font-size: 9px; font-weight: 600; }
.product-cell small { margin-top: 4px; color: #9ba59f; font-size: 8px; }
.category-chip { padding: 4px 7px; border-radius: 4px; background: #f5f7f6; color: #78857e; font-size: 8px; }
.sku-text { display: block; color: #57645d; font-size: 9px; font-weight: 600; }
.barcode-text { display: block; margin-top: 4px; color: #a1aaa5; font-size: 8px; }
.stock-number { display: block; color: #35453c; font-size: 10px; }
.location-code { display: flex; align-items: center; gap: 4px; color: #688477; font-size: 9px; }
.stock-status { display: inline-flex; align-items: center; gap: 5px; font-size: 8px; }
.stock-status i { width: 6px; height: 6px; border-radius: 50%; }
.stock-status.healthy { color: #27835d; }
.stock-status.healthy i { background: #43b17b; }
.stock-status.low { color: #c77b36; }
.stock-status.low i { background: #e7a056; }
.row-menu { width: 27px; height: 27px; display: grid; place-items: center; border: 0; border-radius: 5px; color: #a3ada7; background: transparent; }
.row-actions { display: flex; align-items: center; gap: 2px; }
.row-menu.archive-action:hover { color: #ba694c; background: #fff3ef; }
.table-footer { min-height: 45px; padding: 0 15px; display: flex; align-items: center; justify-content: space-between; border-top: 1px solid #edf1ee; color: #97a29c; font-size: 9px; }
.table-footer strong { color: #617068; }
.table-footer div { display: flex; gap: 6px; }
.table-footer button { padding: 5px 8px; border: 1px solid #e8edea; border-radius: 4px; color: #8a9690; background: #fff; font-size: 8px; }
.table-footer > span:last-child { display: flex; align-items: center; gap: 5px; }
.compact { height: 28px; font-size: 9px; }

.map-summary { min-height: 45px; margin-bottom: 13px; padding: 0 14px; display: flex; align-items: center; gap: 19px; background: #fff; border: 1px solid #e9eeeb; border-radius: 7px; }
.map-summary-item { display: flex; align-items: center; gap: 6px; color: #77847d; font-size: 9px; }
.map-summary-item strong { margin-left: 2px; color: #45554b; }
.map-dot { width: 7px; height: 7px; border-radius: 2px; }
.map-dot.occupied { background: #3eaa79; }
.map-dot.available { background: #dbece2; }
.map-dot.blocked { background: #efb778; }
.map-summary-spacer { flex: 1; }
.map-floor { display: flex; align-items: center; gap: 7px; padding: 7px 9px; border: 1px solid #e9eeeb; border-radius: 5px; color: #617168; font-size: 9px; }
.map-layout { display: grid; grid-template-columns: minmax(0, 1fr) 285px; gap: 14px; align-items: stretch; }
.map-layout:has(.map-toolbox) { grid-template-columns: 170px minmax(0, 1fr) 285px; }
.map-toolbox { padding: 14px 11px; }
.map-toolbox h3 { margin: 6px 0; color: #33433a; font: 700 11px 'Manrope', sans-serif; }
.map-tools-subtitle { margin-top: 15px !important; }
.warehouse-dimensions { margin: 10px 0; display: grid; gap: 8px; }
.warehouse-dimensions label { display: grid; gap: 4px; color: #69786f; font-size: 8px; font-weight: 600; }
.warehouse-dimensions input { width: 100%; height: 28px; padding: 0 7px; border: 1px solid #e1e9e3; border-radius: 4px; color: #425248; background: #fff; font-size: 9px; }
.map-tool-hint { color: #87958d; font-size: 8px; line-height: 1.55; }
.rack-template { margin-top: 12px; padding: 9px 6px; display: flex; align-items: center; gap: 7px; border: 1px solid #e4ebe6; border-radius: 6px; background: #fff; cursor: grab; }
.rack-template:active { cursor: grabbing; }
.rack-template-icon { width: 27px; height: 27px; display: grid; flex: 0 0 27px; place-items: center; border-radius: 5px; color: #30805a; background: #eaf5ee; }
.rack-template > span { min-width: 0; flex: 1; }
.rack-template strong, .rack-template small { display: block; }
.rack-template strong { color: #4b5a51; font-size: 8px; }
.rack-template small { margin-top: 3px; color: #9aa59f; font-size: 7px; }
.rack-template > svg { color: #87968d; }
.map-tool-note { margin-top: 14px; display: flex; align-items: flex-start; gap: 5px; color: #7d9183; font-size: 7px; line-height: 1.5; }
.map-tool-note svg { flex: 0 0 14px; }
.map-panel { overflow: hidden; min-width: 0; }
.map-panel-heading { height: 61px; padding: 0 16px; display: flex; justify-content: space-between; align-items: center; }
.map-panel-heading p span { padding: 0 3px; }
.zoom-controls { display: flex; align-items: center; gap: 8px; padding: 3px; border: 1px solid #e9eeeb; border-radius: 5px; color: #819087; font-size: 9px; }
.zoom-controls button { width: 22px; height: 22px; border: 0; border-radius: 3px; color: #67776d; background: #f6f8f7; font-size: 15px; }
.map-canvas-wrap { height: 464px; overflow: auto; padding: 12px; background: #f0f3ef; border-top: 1px solid #eff2f0; border-bottom: 1px solid #eff2f0; }
.map-canvas { position: relative; margin: 0 auto; border: 1px dashed #dfe7e2; background: #fff; }
.warehouse-boundary { position: absolute; z-index: 0; inset: 4px; border: 4px solid #87988c; border-radius: 7px; background: #e7e8df; box-shadow: inset 0 0 0 2px #fff9; pointer-events: none; }
.map-aisle { position: absolute; z-index: 1; padding: 10px 12px; border: 2px solid #dbcda8; border-radius: 12px; color: #897b5b; background: repeating-linear-gradient(90deg, #f8f2e3 0, #f8f2e3 26px, #f1e9d4 27px, #f1e9d4 29px); box-shadow: 0 3px 8px #675a3912, inset 0 0 0 3px #fff8; font-size: 9px; pointer-events: auto; }
.map-aisle strong { padding: 5px 8px; border: 1px solid #e8dcc0; border-radius: 14px; color: #75684d; background: #fffcf3; font-size: 9px; letter-spacing: .2px; }
.map-aisle.selected { border: 2px solid #19855b; background: repeating-linear-gradient(90deg, #eff7eb 0, #eff7eb 26px, #dfeddc 27px, #dfeddc 29px); box-shadow: 0 0 0 3px #bde0ca; }
.map-aisle.draggable { cursor: grab; touch-action: none; }
.map-aisle.draggable:active { cursor: grabbing; }
.map-zoom-frame { position: relative; }
.map-grid { position: absolute; top: 0; left: 0; pointer-events: none; }
.map-aisle-label, .map-rack-caption { position: absolute; z-index: 1; color: #b1bcb6; font-size: 8px; font-weight: 700; letter-spacing: 1px; pointer-events: none; }
.map-aisle-label { top: 13px; left: 40px; }
.map-rack-caption { right: 30px; bottom: 15px; }
.map-bin { position: absolute; z-index: 2; padding: 5px 6px; display: flex; flex-direction: column; align-items: flex-start; justify-content: space-between; border: 1px solid #cce5d6; border-radius: 5px; text-align: left; transition: box-shadow .12s, transform .12s; }
.map-bin:hover { z-index: 3; transform: translateY(-1px); box-shadow: 0 4px 10px #173a2a12; }
.map-canvas.editing .map-bin { cursor: grab; touch-action: none; }
.map-canvas.editing .map-bin:active { cursor: grabbing; }
.map-bin.occupied { color: #31815b; background: #e9f5ed; border-color: #cde7d7; }
.map-bin.available { color: #859c8d; background: #f5faf6; border-color: #e2eee5; }
.map-bin.blocked { color: #ad783e; background: #fff5e8; border-color: #f2ddbd; }
.map-bin.active { outline: 2px solid #18865d; outline-offset: 2px; }
.map-bin strong { font-size: 9px; }
.map-bin .bin-level { color: #92a198; font-size: 7px; letter-spacing: .4px; }
.bin-stock { font-size: 8px; opacity: .82; }
.map-empty { position: absolute; inset: 0; display: grid; place-items: center; color: #97a39c; font-size: 11px; }
.map-rack { position: absolute; z-index: 2; padding: 10px 14px; display: flex; flex-direction: column; border: 2px solid #57866d; border-radius: 9px; color: #506258; background: #fffdf8; box-shadow: 0 5px 12px #243a2c20, inset 0 0 0 3px #e6efe7; transition: box-shadow .15s, border-color .15s; }
.map-rack::before, .map-rack::after { position: absolute; top: 8px; bottom: 8px; width: 7px; border-radius: 3px; background: linear-gradient(90deg, #6e9a7e, #a4c1a8 50%, #5b876c); box-shadow: 0 1px 2px #1d462a30; content: ''; pointer-events: none; }
.map-rack::before { left: 4px; }
.map-rack::after { right: 4px; }
.map-rack.selected { border-color: #168256; box-shadow: 0 0 0 4px #bfe8cf, 0 7px 16px #173a2a24; }
.map-rack.draggable { cursor: grab; touch-action: none; }
.map-rack.draggable:active { cursor: grabbing; }
.map-rack-heading { min-height: 25px; padding: 0 2px 5px; display: flex; align-items: center; gap: 6px; border-bottom: 3px solid #b8cdbb; color: #45745a; }
