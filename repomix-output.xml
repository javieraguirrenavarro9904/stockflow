<file path="apps/web/src/WarehouseMap2D.tsx">
import { useEffect, useRef, useState, type DragEvent, type KeyboardEvent, type PointerEvent as ReactPointerEvent, type RefObject } from 'react';
import { MAP_RENDER_SCALE, type WarehousePoint } from './warehousePlan';

type MapRack = {
  id: string;
  code: string;
  map_x: string | number;
  map_y: string | number;
  map_width: string | number;
  map_height: string | number;
  bin_count: number;
};

type MapLocation = { rack_id: string; quantity: string | number };

type Props = {
  width: number;
  height: number;
  zoom: number;
  racks: MapRack[];
  locations: MapLocation[];
  selectedRackId: string | null;
  editing: boolean;
  perimeter: WarehousePoint[];
  perimeterDraft: WarehousePoint[];
  drawingPerimeter: boolean;
  editingPerimeter: boolean;
  canvasRef: RefObject<HTMLDivElement>;
  onSelectRack: (rackId: string) => void;
  onMoveRack: (rackId: string, x: number, y: number) => void;
  onResizeRack: (rackId: string, width: number, height: number) => void;
  onDropRack: (x: number, y: number) => void;
  onAddPerimeterPoint: (point: WarehousePoint) => void;
  onMovePerimeterPoint: (index: number, point: WarehousePoint) => void;
  onFinishPerimeter: () => void;
};

const value = (input: string | number) => Number(input) || 0;

export default function WarehouseMap2D({
  width, height, zoom, racks, locations, selectedRackId, editing,
  perimeter, perimeterDraft, drawingPerimeter, editingPerimeter, canvasRef,
  onSelectRack, onMoveRack, onResizeRack, onDropRack, onAddPerimeterPoint, onMovePerimeterPoint, onFinishPerimeter
}: Props) {
  const canvas = useRef<HTMLCanvasElement>(null);
  const drag = useRef<
    | { type: 'moveRack'; id: string; offsetX: number; offsetY: number; moved: boolean }
    | { type: 'resizeRack'; id: string; startX: number; startY: number; initialWidth: number; initialHeight: number }
    | null
  >(null);
  const draggedPerimeterVertex = useRef<number | null>(null);
  const [pointerPosition, setPointerPosition] = useState<WarehousePoint | null>(null);

  useEffect(() => {
    if (canvas.current) canvas.current.style.cursor = drawingPerimeter ? 'crosshair' : editing ? 'grab' : 'pointer';
  }, [drawingPerimeter, editing]);

  useEffect(() => {
    const element = canvas.current;
    const context = element?.getContext('2d');
    if (!element || !context) return;

    const pixelRatio = Math.min(window.devicePixelRatio || 1, 1.5);
    element.width = Math.round(width * MAP_RENDER_SCALE * pixelRatio);
    element.height = Math.round(height * MAP_RENDER_SCALE * pixelRatio);
    context.scale(pixelRatio * MAP_RENDER_SCALE, pixelRatio * MAP_RENDER_SCALE);
    context.fillStyle = '#f8faf8';
    context.fillRect(0, 0, width, height);

    context.strokeStyle = '#e8eeea';
    context.lineWidth = 10;
    for (let x = 0; x <= width; x += 240) {
      context.beginPath();
      context.moveTo(x, 0);
      context.lineTo(x, height);
      context.stroke();
    }
    for (let y = 0; y <= height; y += 240) {
      context.beginPath();
      context.moveTo(0, y);
      context.lineTo(width, y);
      context.stroke();
    }

    if (perimeter.length >= 3) {
      context.beginPath();
      context.moveTo(perimeter[0].x, perimeter[0].y);
      perimeter.slice(1).forEach((point) => context.lineTo(point.x, point.y));
      context.closePath();
      context.fillStyle = '#dce9dfb8';
      context.fill();
      context.strokeStyle = '#71877a';
      context.lineWidth = 30;
      context.stroke();
    } else {
      context.strokeStyle = '#a8b7ac';
      context.lineWidth = 30;
      context.strokeRect(4, 4, width - 8, height - 8);
    }

    if (drawingPerimeter && perimeterDraft.length) {
      context.beginPath();
      context.moveTo(perimeterDraft[0].x, perimeterDraft[0].y);
      perimeterDraft.slice(1).forEach((point) => context.lineTo(point.x, point.y));
      if (editingPerimeter) {
        context.closePath();
        context.fillStyle = '#b9dfc855';
        context.fill();
      } else if (pointerPosition) {
        context.lineTo(pointerPosition.x, pointerPosition.y);
      }
      context.strokeStyle = '#168158';
      context.lineWidth = 30;
      context.setLineDash(editingPerimeter ? [] : [80, 50]);
      context.stroke();
      context.setLineDash([]);
      perimeterDraft.forEach((point, index) => {
        context.beginPath();
        context.arc(point.x, point.y, !editingPerimeter && index === 0 ? 70 : 50, 0, Math.PI * 2);
        context.fillStyle = !editingPerimeter && index === 0 ? '#168158' : '#fff';
        context.fill();
        context.strokeStyle = '#168158';
        context.lineWidth = 20;
        context.stroke();
      });
    }

    racks.forEach((rack) => {
      const x = value(rack.map_x);
      const y = value(rack.map_y);
      const rackWidth = value(rack.map_width);
      const rackHeight = value(rack.map_height);
      const occupied = locations.filter((location) => location.rack_id === rack.id && value(location.quantity) > 0).length;
      const capacity = Math.max(1, rack.bin_count);
      const occupancy = Math.min(1, occupied / capacity);
      const isSelected = rack.id === selectedRackId;
      const fill = occupancy >= 0.8 ? '#fff1e9' : occupancy >= 0.4 ? '#f5f4e8' : '#eaf5ee';
      const accent = occupancy >= 0.8 ? '#d88958' : occupancy >= 0.4 ? '#b5a65b' : '#4b9b70';

      context.fillStyle = fill;
      context.fillRect(x, y, rackWidth, rackHeight);
      context.strokeStyle = isSelected ? '#177e55' : accent;
      context.lineWidth = isSelected ? 30 : 20;
      context.strokeRect(x, y, rackWidth, rackHeight);

      const centerX = x + rackWidth / 2;
      const centerY = y + rackHeight / 2;
      context.textAlign = 'center';
      context.textBaseline = 'middle';
      context.fillStyle = '#283b30';
      context.font = `700 ${Math.max(80, Math.min(140, rackWidth / 16))}px sans-serif`;
      context.fillText(rack.code, centerX, centerY - 35);

      const barWidth = Math.min(rackWidth * 0.62, 1500);
      const barHeight = 50;
      context.fillStyle = '#d7e1da';
      context.fillRect(centerX - barWidth / 2, centerY + 20, barWidth, barHeight);
      context.fillStyle = accent;
      context.fillRect(centerX - barWidth / 2, centerY + 20, barWidth * occupancy, barHeight);
      context.fillStyle = '#65736a';
      context.font = '70px sans-serif';
      context.fillText(`${Math.round(occupancy * 100)}%`, centerX, centerY + 100);

      if (editing) {
        const handleSize = 140;
        context.fillStyle = '#fff';
        context.fillRect(x + rackWidth - 100, y + rackHeight - 100, handleSize, handleSize);
        context.strokeStyle = '#177e55';
        context.lineWidth = 20;
        context.strokeRect(x + rackWidth - 100, y + rackHeight - 100, handleSize, handleSize);
        context.beginPath();
        context.moveTo(x + rackWidth - 80, y + rackHeight - 20);
        context.lineTo(x + rackWidth - 20, y + rackHeight - 80);
        context.stroke();
      }
    });
  }, [width, height, racks, locations, selectedRackId, perimeter, perimeterDraft, drawingPerimeter, editingPerimeter, editing, pointerPosition]);

  const pointFromEvent = (event: ReactPointerEvent<HTMLCanvasElement>) => {
    const rect = event.currentTarget.getBoundingClientRect();
    return {
      x: (event.clientX - rect.left) * width / rect.width,
      y: (event.clientY - rect.top) * height / rect.height
    };
  };

  const findRack = (x: number, y: number) => [...racks].reverse().find((item) =>
      x >= value(item.map_x) && y >= value(item.map_y) &&
      x <= value(item.map_x) + value(item.map_width) && y <= value(item.map_y) + value(item.map_height)
    );

  const snapToGrid = (point: WarehousePoint): WarehousePoint => ({
    x: Math.max(0, Math.min(width, Math.round(point.x / 240) * 240)),
    y: Math.max(0, Math.min(height, Math.round(point.y / 240) * 240))
  });

  const pointerDown = (event: ReactPointerEvent<HTMLCanvasElement>) => {
    const { x, y } = pointFromEvent(event);
    if (drawingPerimeter) {
      event.preventDefault();
      if (editingPerimeter) {
        const vertexIndex = perimeterDraft.findIndex((point) => Math.hypot(x - point.x, y - point.y) <= 140);
        if (vertexIndex >= 0) {
          draggedPerimeterVertex.current = vertexIndex;
          event.currentTarget.setPointerCapture(event.pointerId);
          return;
        }
      }
      const firstPoint = perimeterDraft[0];
      if (!editingPerimeter && perimeterDraft.length >= 3 && firstPoint && Math.hypot(x - firstPoint.x, y - firstPoint.y) <= 140) {
        onFinishPerimeter();
      } else {
        onAddPerimeterPoint(snapToGrid({ x, y }));
      }
      return;
    }
    if (editing) {
      const resizeRack = [...racks].reverse().find((rack) =>
        Math.abs(x - (value(rack.map_x) + value(rack.map_width))) <= 140 &&
        Math.abs(y - (value(rack.map_y) + value(rack.map_height))) <= 140
      );
      if (resizeRack) {
        drag.current = {
          type: 'resizeRack',
          id: resizeRack.id,
          startX: x,
          startY: y,
          initialWidth: value(resizeRack.map_width),
          initialHeight: value(resizeRack.map_height)
        };
        event.currentTarget.setPointerCapture(event.pointerId);
        return;
      }
    }
    const rack = findRack(x, y);
    if (!rack) return;
    if (editing) {
      drag.current = {
        type: 'moveRack',
        id: rack.id,
        offsetX: x - value(rack.map_x), offsetY: y - value(rack.map_y), moved: false
      };
      event.currentTarget.setPointerCapture(event.pointerId);
    } else onSelectRack(rack.id);
  };

  const pointerMove = (event: ReactPointerEvent<HTMLCanvasElement>) => {
    if (drawingPerimeter) {
      const point = pointFromEvent(event);
      if (draggedPerimeterVertex.current !== null) {
        onMovePerimeterPoint(draggedPerimeterVertex.current, snapToGrid(point));
      } else if (!editingPerimeter) {
        setPointerPosition(snapToGrid(point));
      }
      return;
    }
    setPointerPosition(null);
    if (!editing) return;
    const { x, y } = pointFromEvent(event);
    if (!drag.current) {
      const hoveringResizeHandle = [...racks].reverse().some((rack) =>
        Math.abs(x - (value(rack.map_x) + value(rack.map_width))) <= 140 &&
        Math.abs(y - (value(rack.map_y) + value(rack.map_height))) <= 140
      );
      event.currentTarget.style.cursor = hoveringResizeHandle ? 'nwse-resize' : 'grab';
      return;
    }
    if (drag.current.type === 'moveRack') {
      drag.current.moved = true;
      onMoveRack(drag.current.id,
        Math.max(0, Math.round(x - drag.current.offsetX)),
        Math.max(0, Math.round(y - drag.current.offsetY)));
    } else {
      onResizeRack(drag.current.id,
        drag.current.initialWidth + x - drag.current.startX,
        drag.current.initialHeight + y - drag.current.startY);
    }
  };

  const pointerUp = (event: ReactPointerEvent<HTMLCanvasElement>) => {
    draggedPerimeterVertex.current = null;
    const currentDrag = drag.current;
    if (currentDrag) {
      if (currentDrag.type === 'moveRack' && !currentDrag.moved) onSelectRack(currentDrag.id);
      drag.current = null;
    }
    if (event.currentTarget.hasPointerCapture(event.pointerId)) event.currentTarget.releasePointerCapture(event.pointerId);
  };

  const drop = (event: DragEvent<HTMLDivElement>) => {
    if (event.dataTransfer.getData('application/stockflow-map-element') !== 'rack') return;
    event.preventDefault();
    const rect = event.currentTarget.getBoundingClientRect();
    onDropRack(Math.max(0, Math.round((event.clientX - rect.left) * width / rect.width)),
      Math.max(0, Math.round((event.clientY - rect.top) * height / rect.height)));
  };

  const selectedIndex = racks.findIndex((rack) => rack.id === selectedRackId);
  const handleKeyDown = (event: KeyboardEvent<HTMLCanvasElement>) => {
    if (event.key === 'Enter' && selectedRackId) onSelectRack(selectedRackId);
    if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
      event.preventDefault();
      if (racks.length)       onSelectRack(racks[(selectedIndex < 0 ? 0 : selectedIndex + 1) % racks.length].id);
    }
    if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
      event.preventDefault();
      if (racks.length)       onSelectRack(racks[(selectedIndex < 0 ? racks.length - 1 : selectedIndex - 1 + racks.length) % racks.length].id);
    }
  };

  return (
    <div
      ref={canvasRef}
      className={`warehouse-map-canvas ${editing ? 'editing' : ''} ${drawingPerimeter ? 'drawing-perimeter' : ''}`}
      style={{ width: width * MAP_RENDER_SCALE, height: height * MAP_RENDER_SCALE, transform: `scale(${zoom})`, transformOrigin: 'top left' }}
      onDragOver={(event) => {
        if (event.dataTransfer.types.includes('application/stockflow-map-element')) event.preventDefault();
      }}
      onDrop={drop}
    >
      <canvas
        ref={canvas}
        aria-label="Plano cenital del almacén. Navega entre estanterías con las flechas y pulsa Intro para abrir una."
        role="application"
        tabIndex={0}
        onPointerDown={pointerDown}
        onPointerMove={pointerMove}
        onPointerLeave={() => setPointerPosition(null)}
        onPointerUp={pointerUp}
        onPointerCancel={() => { drag.current = null; draggedPerimeterVertex.current = null; }}
        onKeyDown={handleKeyDown}
      />
    </div>
  );
}
